# 접속 비밀번호 — 운영 배포 전 반드시 변경하세요.
# 미설정 시 개발 기본값 'chuncheon2026' 사용
ADMIN_PASSWORD=
# 세션 쿠키 파생용 솔트 (운영에서는 임의의 긴 문자열 권장)
ADMIN_SESSION_SECRET=

# Supabase (없으면 시민 앱과 공유하는 로컬 파일 저장소 사용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=report-photos

# VLM 사진 자동 분류
VLM_API_URL=
VLM_API_KEY=
VLM_MODEL=gpt-4o-mini

# Supabase 미설정 시 두 앱이 공유할 로컬 데이터 경로 (기본: 저장소 루트의 .data)
CCBS_DATA_DIR=
