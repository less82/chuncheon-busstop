# ─────────────────────────────────────────────
# 시민 앱 (B2C) — http://localhost:3000
# 모든 값은 선택 사항이며, 비워두면 Mock 모드로 단독 동작합니다.
# ─────────────────────────────────────────────

# 공공데이터포털 TAGO 버스도착정보 (없으면 Mock 도착정보 생성)
TAGO_SERVICE_KEY=
TAGO_CITY_CODE=32010

# Supabase (없으면 관리자 앱과 공유하는 로컬 파일 저장소 사용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=report-photos

# VLM 사진 자동 분류 (없으면 규칙기반 Mock 태깅)
VLM_API_URL=
VLM_API_KEY=
VLM_MODEL=gpt-4o-mini

# Supabase 미설정 시 두 앱이 공유할 로컬 데이터 경로 (기본: 저장소 루트의 .data)
CCBS_DATA_DIR=
