{
  "name": "chuncheon-busstop",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n citizen,admin -c blue,magenta \"npm:dev:citizen\" \"npm:dev:admin\"",
    "dev:citizen": "npm run dev --workspace @ccbs/citizen",
    "dev:admin": "npm run dev --workspace @ccbs/admin",
    "build": "npm run build --workspace @ccbs/citizen && npm run build --workspace @ccbs/admin",
    "start": "concurrently -n citizen,admin -c blue,magenta \"npm:start:citizen\" \"npm:start:admin\"",
    "start:citizen": "npm run start --workspace @ccbs/citizen",
    "start:admin": "npm run start --workspace @ccbs/admin",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
